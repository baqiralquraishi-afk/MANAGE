# HUMANITY PLATFORM - Environment Variables Template
# STRICT NOTICE: Use dummy/fictional values only. Never place production keys or real secrets here.

# Local Supabase Configuration (Disposable Local Stack)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key_for_local_development_only.example
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key_server_only.example

# Next.js Application Environment
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_FALLBACK_LOCALE=en

# Server-Side Operational Settings
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PORT=3000

