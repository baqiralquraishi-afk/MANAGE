{
  "name": "humanity-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Humanity Platform - Beneficiary and Case Management System",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "build:contracts": "pnpm --filter @humanity/contracts build",
    "build": "pnpm --filter @humanity/contracts build && pnpm --filter web build",
    "lint": "pnpm --recursive --parallel run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test:rls": "node --test supabase/tests/rls_authorization_test.mjs",
    "test:workflows": "node --test supabase/tests/backend_workflows_test.mjs",
    "test:beneficiaries": "node --test supabase/tests/beneficiary_case_management_test.mjs",
    "test:assistance": "node --test supabase/tests/assistance_financial_workflows_test.mjs",
    "test:supporting": "node --test supabase/tests/supporting_modules_test.mjs",
    "test:sync": "node --test supabase/tests/encrypted_offline_sync_test.mjs",
    "test:audit": "node --test supabase/tests/audit_and_security_hardening_test.mjs",
    "test:adversarial": "node --test supabase/tests/security_adversarial_test.mjs",
    "test": "pnpm --recursive run test && node --test supabase/tests/rls_authorization_test.mjs && node --test supabase/tests/backend_workflows_test.mjs && node --test supabase/tests/beneficiary_case_management_test.mjs && node --test supabase/tests/assistance_financial_workflows_test.mjs && node --test supabase/tests/supporting_modules_test.mjs && node --test supabase/tests/encrypted_offline_sync_test.mjs && node --test supabase/tests/audit_and_security_hardening_test.mjs && node --test supabase/tests/security_adversarial_test.mjs",
    "benchmark": "node scripts/performance-benchmark.js",
    "verify:licenses": "node scripts/verify-licenses.js",
    "format": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yaml,yml}\"",
    "format:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yaml,yml}\"",
    "verify": "node scripts/verify-setup.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
