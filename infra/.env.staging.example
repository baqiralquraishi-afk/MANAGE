# ==============================================================================
# Humanity Platform — Staging Environment Template (.env.staging.example)
# NOTICE: Use fictional template values only. Never insert real secrets or commit
# production credentials into source control. Production secrets must be fetched
# dynamically from HashiCorp Vault / AWS Secrets Manager / Sealed Secrets.
# ==============================================================================

# Domain & Networking
DOMAIN_NAME=humanity.staging.internal
STAGING_SERVER_IP=10.140.20.10

# Database Passwords (Must be >= 24 chars high-entropy alphanumeric)
POSTGRES_ROOT_PASSWORD=staging_db_root_placeholder_pass_1234
POSTGRES_AUTHENTICATOR_PASSWORD=staging_authenticator_pass_1234
POSTGRES_AUTH_PASSWORD=staging_gotrue_pass_1234
POSTGRES_STORAGE_PASSWORD=staging_storage_pass_1234

# Supabase Auth / JWT Configuration
JWT_SECRET=staging_jwt_secret_minimum_32_bytes_super_secure_key_123
SUPABASE_ANON_KEY=staging_public_anon_jwt_token_placeholder
SUPABASE_SERVICE_ROLE_KEY=staging_service_role_jwt_token_placeholder

# MinIO Private S3 Storage
MINIO_ROOT_USER=humanity_minio_staging_admin
MINIO_ROOT_PASSWORD=staging_minio_storage_secure_password_1234

